[Unit]
Description=Vehicle C2 Node
After=network.target

[Service]
Type=simple
# Optionally set C2_ROOT in an Environment or EnvironmentFile; otherwise the runner will autodetect.
Environment=C2_ROOT=/opt/c2
ExecStart=/bin/bash -c '$C2_ROOT/tools/c2_service_runner.sh'
Restart=on-failure
RestartSec=5
User=root
WorkingDirectory=%h

[Install]
WantedBy=multi-user.target
