[Unit]
Description=Vehicle C2 Node
After=network.target

[Service]
Type=simple
# Optionally set C2_ROOT in an Environment or EnvironmentFile; otherwise the runner will autodetect.
Environment=C2_ROOT=/opt/c2
ExecStart=/opt/c2/tools/c2_service_runner.sh
Restart=on-failure
RestartSec=5
User=c2
Group=c2
WorkingDirectory=/opt/c2
RuntimeDirectory=c2
RuntimeDirectoryMode=0755
PIDFile=/run/c2_service.pid

[Install]
WantedBy=multi-user.target
