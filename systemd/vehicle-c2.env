# Example environment file for Vehicle C2
# Copy to /etc/vehicle-c2-node.env and adjust values for your system

RIG_MODEL=2                # Hamlib model number for your radio
RIG_DEVICE=/dev/ttyUSB0    # serial device for radio CAT/PTT
RIGCTLD_PORT=4532

GPSD_DEVICE=/dev/ttyACM0
GPSD_PORT=2947

# Backend runtime options
RIGCTLD_HOST=127.0.0.1
GPSD_HOST=127.0.0.1